<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
	<TargetFramework>net10.0</TargetFramework>
	<ImplicitUsings>enable</ImplicitUsings>
	<Nullable>enable</Nullable>
	<DocnetRuntime Condition=" '$([MSBuild]::IsOsPlatform(Windows))' ">win-x64</DocnetRuntime>
  </PropertyGroup>
  <ItemGroup>
	<ProjectReference Include="..\SewerScan.Application\SewerScan.Application.csproj" />
	<ProjectReference Include="..\SewerScan.Domain\SewerScan.Domain.csproj" />
  </ItemGroup>
	<ItemGroup>
	  <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
	  <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
		<PrivateAssets>all</PrivateAssets>
	  </PackageReference>
	  <!-- Official PdfPig package. Replaces the old custom 1.7.0 build which failed on CAD xref tables. -->
	  <PackageReference Include="PdfPig" />
	  <PackageReference Include="Docnet.Core" />
	</ItemGroup>
	<ItemGroup>
	  <PackageReference Include="Magick.NET-Q8-AnyCPU" />
	  <PackageReference Include="Tesseract" />
	</ItemGroup>
</Project>
