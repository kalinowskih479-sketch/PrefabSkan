<Window x:Class="SewerScan.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PrefabScan" Height="840" Width="1420" MinHeight="650" MinWidth="1050">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="PrefabScan" FontSize="28" FontWeight="SemiBold"/>
            <TextBlock Text="Analiza dokumentacji kanalizacyjnej — tekst PDF + OCR techniczny + scalanie PZT/profili" Margin="0,4,0,14"/>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="OpenPdfButton" Content="Wybierz PDF-y" Padding="18,8" Click="OpenPdfButton_Click" VerticalAlignment="Top"/>
            <TextBox x:Name="FilePathBox" Grid.Column="1" Margin="10,0" IsReadOnly="True" Height="58"
                     AcceptsReturn="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
            <Button x:Name="BenchmarkTestButton" Grid.Column="2" Content="TEST BATOREGO" Padding="18,8" Margin="0,0,10,0"
                    Click="BenchmarkTestButton_Click" VerticalAlignment="Top"/>
            <Button x:Name="AnalyzeButton" Grid.Column="3" Content="Analizuj zestaw" Padding="20,8" Margin="0,0,10,0"
                    IsEnabled="False" Click="AnalyzeButton_Click" VerticalAlignment="Top"/>
            <Button x:Name="ExportButton" Grid.Column="4" Content="Eksport Excel" Padding="20,8" Margin="0,0,10,0"
                    IsEnabled="False" Click="ExportButton_Click" VerticalAlignment="Top"/>
            <Button x:Name="ExportDiagnosticsButton" Grid.Column="5" Content="Eksport diagnostyki TXT" Padding="18,8"
                    IsEnabled="False" Click="ExportDiagnosticsButton_Click" VerticalAlignment="Top"/>
        </Grid>

        <TabControl x:Name="ResultsTabs" Grid.Row="2">
            <TabItem Header="Studnie">
                <DataGrid x:Name="ManholesGrid" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" CanUserSortColumns="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Oznaczenie" Binding="{Binding Identifier}" Width="95"/>
                        <DataGridTextColumn Header="Typ" Binding="{Binding Type}" Width="115"/>
                        <DataGridTextColumn Header="DN [mm]" Binding="{Binding DiameterMm}" Width="80"/>
                        <DataGridTextColumn Header="Rz. góry [m]" Binding="{Binding GroundElevationM}" Width="95"/>
                        <DataGridTextColumn Header="Rz. dna [m]" Binding="{Binding InvertElevationM}" Width="95"/>
                        <DataGridTextColumn Header="Wys. [m]" Binding="{Binding HeightM}" Width="75"/>
                        <DataGridTextColumn Header="Zwieńczenie" Binding="{Binding Crown}" Width="150"/>
                        <DataGridTextColumn Header="Przejścia" Binding="{Binding TransitionsText}" Width="220"/>
                        <DataGridTextColumn Header="Pewność" Binding="{Binding Confidence}" Width="80"/>
                        <DataGridTextColumn Header="Kompletność" Binding="{Binding Completeness}" Width="85"/>
                        <DataGridTextColumn Header="Brakujące dane" Binding="{Binding MissingData}" Width="180"/>
                        <DataGridTextColumn Header="Uwagi walidacji" Binding="{Binding ValidationIssues}" Width="190"/>
                        <DataGridTextColumn Header="Źródła" Binding="{Binding Sources}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem Header="Wpusty">
                <DataGrid x:Name="InletsGrid" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Oznaczenie" Binding="{Binding Identifier}" Width="150"/>
                        <DataGridTextColumn Header="Pewność" Binding="{Binding Confidence}" Width="100"/>
                        <DataGridTextColumn Header="Źródła" Binding="{Binding Sources}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem Header="Rury">
                <DataGrid x:Name="PipesGrid" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Materiał" Binding="{Binding Material}" Width="110"/>
                        <DataGridTextColumn Header="DN [mm]" Binding="{Binding DiameterMm}" Width="90"/>
                        <DataGridTextColumn Header="Strona" Binding="{Binding Page}" Width="70"/>
                        <DataGridTextColumn Header="Źródło" Binding="{Binding SourceDocument}" Width="220"/>
                        <DataGridTextColumn Header="Tekst" Binding="{Binding RawText}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem x:Name="DiagnosticsTab" Header="Diagnostyka">
                <TextBox x:Name="DiagnosticsBox" IsReadOnly="True" AcceptsReturn="True" AcceptsTab="True"
                         TextWrapping="NoWrap" FontFamily="Consolas" FontSize="12"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
            </TabItem>
        </TabControl>

        <Border Grid.Row="3" Margin="0,10,0,0" Padding="8,6" BorderBrush="#A0A0A0" BorderThickness="1" CornerRadius="3">
            <TextBlock x:Name="BenchmarkText" FontWeight="SemiBold" Text="Benchmark: oczekuje na analizę." TextWrapping="Wrap"/>
        </Border>
        <TextBlock x:Name="StatusText" Grid.Row="4" Margin="0,8,0,0" Text="Gotowy. Wybierz jeden lub kilka PDF-ów tego samego projektu."/>
    </Grid>
</Window>
