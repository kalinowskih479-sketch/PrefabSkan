<Project>
  <PropertyGroup>
    <Version>4.2.8</Version>
    <AssemblyVersion>4.2.8.0</AssemblyVersion>
    <FileVersion>4.2.8.0</FileVersion>
    <InformationalVersion>4.2.8</InformationalVersion>
    <Product>PrefabScan</Product>
    <Company>PrefabScan</Company>
    <RepositoryUrl>https://github.com/kalinowskih479-sketch/PrefabSkan</RepositoryUrl>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>
</Project>
